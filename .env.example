# DockProof Environment Variables
# Copy to .env.local and fill in values

# Gemini API Key for VLM inspection
GEMINI_API_KEY=

# Database path
DATABASE_URL=file:./data/dockproof.db

# Auth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=dockproof-dev-secret-change-in-production

# Image storage path
IMAGE_STORAGE_PATH=./data/images

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# VLM mode: 'live' or 'mock'
VLM_MODE=mock
