# DockProof Environment Variables
# Copy to .env.local and fill in values

# VLM Inference Mode: 'live' or 'mock'
VLM_MODE=mock

# VLM Provider: 'gemini' or 'openrouter'
VLM_PROVIDER=gemini

# Google Gemini Configuration (Gemini 2.0 Flash / 1.5 Flash / 1.5 Pro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter Configuration (Open-Source Vision: Qwen 2.5 VL, Llama 3.2 Vision, Pixtral)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-vl-72b-instruct

# SQLite currently uses the fixed local path ./data/dockproof.db.
# The application does not read DATABASE_URL yet.

# Auth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=dockproof-dev-secret-change-in-production

# Image storage path
IMAGE_STORAGE_PATH=./data/images

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
